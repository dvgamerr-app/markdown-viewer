# editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[docs/example.md]
# the page shows markdown syntax, including hard breaks and list indents
trim_trailing_whitespace = false
indent_size = unset
