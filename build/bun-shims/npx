#!/bin/sh
# node-sass has no binary for bun, swap in dart-sass with the same flags
if [ "$1" = "node-sass" ]; then
  shift
  args=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --include-path) args="$args --load-path=$2"; shift 2 ;;
      *) args="$args $1"; shift ;;
    esac
  done
  exec bun x sass --quiet-deps --silence-deprecation=import --no-source-map $args
fi
exec bun x "$@"
